<mujoco model="diff_drive">
    <!-- diff_drive.xml (Fusion 에서 내보낸 원본) 을 복사한 파일.
         원본은 그대로 두고, 여기에 "학생 추가" 표시가 있는 줄만 더함 -->
    <compiler angle="radian" eulerseq="XYZ" inertiafromgeom="false" />
    <option timestep="0.002" integrator="implicitfast" />
    <asset>
        <mesh name="base_link" file="meshes/base_link.stl" scale="0.001 0.001 0.001" />
        <mesh name="left_wheel_1" file="meshes/left_wheel_1.stl" scale="0.001 0.001 0.001" />
        <mesh name="right_wheel_1" file="meshes/right_wheel_1.stl" scale="0.001 0.001 0.001" />
    </asset>
    <worldbody>
        <light directional="true" pos="-0.5 0.5 3" dir="0 0 -1" />
        <body name="base_link" pos="0.0 0.0 0.0" euler="0.0 -0.0 0.0">
            <!-- [학생 추가 0] (선택) geom 줄 끝에 rgba 를 넣어 색 바꾸기 -->
            <geom name="base_link_geom" type="mesh" mesh="base_link" pos="0 0 0" euler="0 0 0" contype="0" conaffinity="0" group="2" rgba="0.95 0.6 0.2 1" />
            <inertial mass="1.4978753675533543" pos="-0.02064843561071525 1.62578722264246e-14 0.049667097789141725" fullinertia="0.002751945963293217 0.005342105454618316 0.007439193640240557 1.6906030827719706e-15 -3.458188166395896e-05 9.048620482307734e-16" />

            <!-- ===== [학생 추가 1] 자유 이동 관절 + 캐스터 충돌 (base_link body 안) ===== -->
            <freejoint name="root" />
            <geom name="caster_col" type="sphere" size="0.015" pos="-0.09 0 0.015" friction="0.01" priority="1" group="3" />

            <body name="left_wheel_1" pos="0.0 0.0 0.0" euler="0.0 -0.0 0.0">
                <joint name="left_wheel_joint" type="hinge" axis="0.0 1.0 0.0" pos="0.0 0.075 0.04" />
                <geom name="left_wheel_1_geom" type="mesh" mesh="left_wheel_1" pos="0 0 0" euler="0 0 0" contype="0" conaffinity="0" group="2" rgba="0.15 0.15 0.15 1" />
                <inertial mass="0.10656282280976578" pos="0.0 0.085 0.039999999999999994" fullinertia="4.617722321756325e-05 8.52502582478115e-05 4.617722321756553e-05 -1.8076207197736947e-20 -2.4101609596982597e-20 5.421010862427522e-20" />
                <!-- ===== [학생 추가 2] 바퀴 충돌 원기둥 ===== -->
                <geom name="left_wheel_col" type="cylinder" size="0.04 0.01" pos="0 0.085 0.04" euler="1.5708 0 0" group="3" />
            </body>
            <body name="right_wheel_1" pos="0.0 0.0 0.0" euler="0.0 -0.0 0.0">
                <joint name="right_wheel_joint" type="hinge" axis="0.0 1.0 0.0" pos="0.0 -0.075 0.04" />
                <geom name="right_wheel_1_geom" type="mesh" mesh="right_wheel_1" pos="0 0 0" euler="0 0 0" contype="0" conaffinity="0" group="2" rgba="0.15 0.15 0.15 1" />
                <inertial mass="0.10656282280976578" pos="0.0 -0.085 0.039999999999999994" fullinertia="4.617722321756325e-05 8.52502582478115e-05 4.617722321756553e-05 -3.012701199622825e-20 -2.4101609596982597e-20 -5.421010862427522e-20" />
                <!-- ===== [학생 추가 2] 바퀴 충돌 원기둥 ===== -->
                <geom name="right_wheel_col" type="cylinder" size="0.04 0.01" pos="0 -0.085 0.04" euler="1.5708 0 0" group="3" />
            </body>
        </body>

        <!-- ===== [학생 추가 3] 바닥 + 목표 표시 (worldbody 안) ===== -->
        <geom name="floor" type="plane" size="5 5 0.05" material="grid" />
        <site name="goal" type="cylinder" size="0.1 0.002" pos="1 0 0.002" rgba="0.1 0.9 0.2 0.6" />
    </worldbody>

    <!-- ===== [학생 추가 4] 바닥 무늬 + 바퀴 속도 모터 2개 ===== -->
    <asset>
        <texture name="grid" type="2d" builtin="checker" rgb1="0.25 0.3 0.35" rgb2="0.2 0.24 0.28" width="300" height="300" />
        <material name="grid" texture="grid" texrepeat="20 20" />
    </asset>
    <actuator>
        <velocity name="left_motor" joint="left_wheel_joint" kv="0.05" ctrlrange="-15 15" forcerange="-0.1 0.1" />
        <velocity name="right_motor" joint="right_wheel_joint" kv="0.05" ctrlrange="-15 15" forcerange="-0.1 0.1" />
    </actuator>
</mujoco>
